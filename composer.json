{
    "name": "fluffydiscord/sylius-chatbot-bundle",
    "description": "Chatbot tool server endpoints, data sources and widget embed for Sylius 1.14 and 2.x shops",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "doctrine/collections": "^1.8 || ^2.1",
        "doctrine/doctrine-bundle": "^2.13 || ^3.2 || ^4.0",
        "doctrine/orm": "^2.20 || ^3.6 || ^4.0",
        "liip/imagine-bundle": "^2.13",
        "sylius/sylius": "^1.14 || ^2.2 || ^2.3@alpha",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.4 || ^8.0",
        "symfony/security-http": "^6.4 || ^7.4 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.4 || ^8.0",
        "symfony/translation": "^6.4 || ^7.4 || ^8.0",
        "symfony/validator": "^6.4 || ^7.4 || ^8.0",
        "twig/twig": "^2.12 || ^3.3"
    },
    "require-dev": {
        "monsieurbiz/sylius-cms-page-plugin": "^2.2",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "FluffyDiscord\\SyliusChatbotBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FluffyDiscord\\SyliusChatbotBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false,
            "php-http/discovery": false,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
